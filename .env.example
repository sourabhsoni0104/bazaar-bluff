# Server configuration. Never commit .env or paste secret values into chat.
PORT=3000
SITE_URL=http://localhost:3000
NODE_ENV=development

# PostgreSQL: direct connection or Supabase session pooler (5432), not transaction mode.
DATABASE_URL=
DATABASE_SSL=false

# Supabase Google OAuth. Configure the Google provider in the Supabase dashboard.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Comma-separated verified Google emails. Never grant admin through user metadata.
ADMIN_EMAILS=

# Optional local development only. Automatically disabled when NODE_ENV=production.
ALLOW_LOCAL_ADMIN=false
ADMIN_PASSWORD=

# Test infrastructure, isolated from the live event.
TEST_DATABASE_URL=postgresql:///bazaar_bluff_test?host=/tmp
